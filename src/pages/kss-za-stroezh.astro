---
/**
 * Landing page targeting the searches "КСС", "КСС за строеж", "изготвяне на КСС".
 * Prices come from the same quote() as the home page calculator.
 */
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { pricingMin, quote, site } from "../data/site";

const url = new URL("/kss-za-stroezh/", Astro.site).toString();
const eur = (n: number) => `${Math.round(n).toLocaleString("bg-BG")} €`;
const examples = [
  { label: "Апартамент, 90 м²", area: 90 },
  { label: "Еднофамилна къща, 280 м²", area: 280 },
  { label: "Жилищна сграда, 640 м²", area: 640 },
  { label: "Хале, 2200 м²", area: 2200 },
];

const faq = [
  {
    q: "Какво е КСС?",
    a: "КСС (количествено-стойностна сметка) е документ, който описва всички строително-монтажни работи по обекта — с мярка, количество, единична цена и обща стойност. Използва се за оферта към инвеститора, за договор, за участие в обществена поръчка и като основа за месечните актове обр. 19.",
  },
  {
    q: "Каква е разликата между количествена сметка и КСС?",
    a: "Количествената сметка съдържа само видовете работи и количествата. КСС добавя единичните цени и стойностите — тоест показва колко струва строежът.",
  },
  {
    q: "Колко струва изготвянето на КСС?",
    a: `Минималната цена е ${pricingMin.kss} €. Над нея цената се смята по разгънатата застроена площ — например около ${eur(quote(280).kss)} за къща от 280 м² и около ${eur(quote(640).kss)} за жилищна сграда от 640 м². Точната цена ви казваме в същия ден.`,
  },
  {
    q: "Колко време отнема?",
    a: "Цената и срока ви казваме в същия ден. Стандартният срок за готова КСС е до два работни дни, а при спешност — същия ден.",
  },
  {
    q: "Какво трябва да ви изпратя?",
    a: "Чертежите (DWG, PDF или сканирани), количествена сметка, ако имате, или само данните за обекта — площ, вид и какво ви трябва. Ако нещо липсва, ще ви се обадим.",
  },
  {
    q: "Изготвяте ли КСС за банка и за обществени поръчки?",
    a: "Да. Изготвяме КСС за пред банка при кредитиране, КСС по образец на възложителя за обществени поръчки, както и актуализация на КСС при промяна на цените на материалите.",
  },
];

const schema = [
  {
    "@type": "Service",
    name: "Изготвяне на КСС (количествено-стойностна сметка) за строеж",
    serviceType: "Количествено-стойностна сметка",
    url,
    provider: { "@id": `${Astro.site}#business` },
    areaServed: { "@type": "Country", name: "България" },
    offers: { "@type": "Offer", priceCurrency: "EUR", price: pricingMin.kss, description: `От ${pricingMin.kss} € — цената се смята по квадратура` },
  },
  {
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Начало", item: new URL("/", Astro.site).toString() },
      { "@type": "ListItem", position: 2, name: "КСС за строеж", item: url },
    ],
  },
];
---

<Layout
  title={`КСС за строеж — изготвяне на количествено-стойностна сметка от ${pricingMin.kss} € | StroyDocs`}
  description={`Изготвяне на КСС за строеж по чертежи DWG или PDF. Цена от ${pricingMin.kss} €, оферта в същия ден, готова КСС до 2 работни дни. Работим с фирми в цялата страна.`}
  schema={schema}
>
  <PageHeader />
  <main id="main" class="content-page">
    <section class="section surface-a">
      <div class="wrap max-w-4xl">
        <nav class="text-sm text-muted" aria-label="Навигация">
          <a href="/" class="hover:text-white">Начало</a> <span aria-hidden="true">/</span> КСС за строеж
        </nav>
        <h1 class="mt-6 font-display text-[clamp(36px,6vw,72px)] leading-[1.05] font-semibold">КСС за строеж</h1>
        <p class="lead mt-6 max-w-3xl">
          Изготвяме количествено-стойностни сметки за строителни фирми и инвеститори — по чертежи, количествена сметка или
          само по данните за обекта. Цената ви казваме в същия ден, а готовата КСС е при вас до два работни дни.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href="/#contact" class="btn-white">Изпрати чертежите <span class="btn-arrow" aria-hidden="true">→</span></a>
          <a href={site.phoneHref} class="btn-dark"><i class="fa-solid fa-phone" aria-hidden="true"></i> {site.phoneDisplay}</a>
        </div>
      </div>
    </section>

    <section class="section surface-b">
      <div class="wrap max-w-4xl prose-kss">
        <h2>Какво е КСС</h2>
        <p>
          <strong>КСС (количествено-стойностна сметка)</strong> е документът, в който всяка строително-монтажна работа по
          обекта е описана с мярка, количество, единична цена и обща стойност. По нея изпълнителят дава оферта, страните
          подписват договор, а по време на строежа на нейна основа се изготвят месечните <strong>актове обр. 19</strong> за
          плащане.
        </p>
        <p>
          <strong>Количествената сметка</strong> съдържа само видовете работи и количествата. КСС добавя цените — тоест
          показва колко ще струва строежът.
        </p>

        <h2>Кога ви трябва КСС</h2>
        <ul>
          <li>Оферта към инвеститор или главен изпълнител</li>
          <li>Договор за СМР или с подизпълнители</li>
          <li>Участие в обществена поръчка — КСС по образец на възложителя</li>
          <li>Кредит — КСС за пред банка</li>
          <li>Месечно отчитане на изпълнените работи с акт обр. 19</li>
          <li>Промяна на цените на материалите — актуализация на КСС</li>
        </ul>

        <h2>Какво получавате</h2>
        <ul>
          <li>КСС в <strong>Excel</strong> с формули — можете да я редактирате — и в <strong>PDF</strong>, готова за подпис</li>
          <li>Разбивка по видове СМР и раздели, с междинни суми и рекапитулация</li>
          <li>По желание — разбивка по труд, материали и механизация и анализи на единичните цени</li>
          <li>Количества, проверени спрямо чертежите</li>
          <li>Две корекции, включени в цената</li>
        </ul>

        <h2>Цена на КСС</h2>
        <p>
          Минималната цена е <strong>{pricingMin.kss} €</strong>. Над нея цената се смята по разгънатата застроена площ, като
          всеки следващ диапазон квадратура е по-евтин — общата сума винаги расте с площта, а цената на квадрат пада.
          Ориентировъчно:
        </p>
        <div class="kss-examples">
          {
            examples.map((e) => (
              <div>
                <span>{e.label}</span>
                <b>{eur(quote(e.area).kss)}</b>
              </div>
            ))
          }
        </div>
        <p class="text-sm text-muted">
          Ориентировъчни цени за ново строителство. Точната цена зависи от вида на обекта и обхвата. Плащане: 50% аванс при
          възлагане и 50% при предаване. <a href="/#pricing">Изчислете за вашия обект →</a>
        </p>

        <h2>Как работим</h2>
        <ol>
          <li><strong>Изпращате</strong> чертежите (DWG, PDF или сканирани), количествената сметка или само данните за обекта.</li>
          <li><strong>В същия ден</strong> получавате фиксирана цена и срок — без ангажимент.</li>
          <li><strong>До два работни дни</strong> получавате готовата КСС. При спешност — същия ден.</li>
        </ol>

        <h2>Често задавани въпроси за КСС</h2>
        <div class="faq">
          {
            faq.map((f) => (
              <details>
                <summary>
                  {f.q}
                  <span class="plus" aria-hidden="true" />
                </summary>
                <p class="answer">{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section surface-a">
      <div class="wrap max-w-4xl text-center">
        <h2 class="font-display text-[clamp(30px,4vw,48px)] leading-tight font-semibold">Пратете чертежите — цената е до края на деня.</h2>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
          <a href="/#contact" class="btn-white">Изпрати запитване <span class="btn-arrow" aria-hidden="true">→</span></a>
          <a href={site.viberHref} class="btn-dark"><i class="fa-brands fa-viber" aria-hidden="true"></i> Viber</a>
          <a href={site.phoneHref} class="btn-dark"><i class="fa-solid fa-phone" aria-hidden="true"></i> {site.phoneDisplay}</a>
        </div>
        <p class="mt-10 text-sm text-muted">
          Вижте и: <a href="/#services">всички услуги</a> · <a href="/#pricing">калкулатор на цената</a> ·
          <a href="/#contact">контакти</a>
        </p>
      </div>
    </section>
  </main>

  <footer class="border-t border-white/10 bg-[#0a111c]">
    <div class="wrap flex flex-col gap-6 py-10 sm:flex-row sm:items-center sm:justify-between">
      <a href="/" aria-label={`${site.name} — начало`}>
        <img src="/brand/stroydocs-logo-dark.svg" alt="StroyDocs — КСС, актове, оферти" width="236" height="72" class="h-[64px] w-auto" />
      </a>
      <p class="text-sm text-muted">Строителна документация · {site.city}</p>
      <a href={site.phoneHref} class="text-lg font-semibold">{site.phoneDisplay}</a>
    </div>
  </footer>

  <div class="fab">
    <a href={site.viberHref} class="fab-viber" aria-label="Пишете ни във Viber"><i class="fa-brands fa-viber" aria-hidden="true"></i></a>
    <a href={site.phoneHref} class="fab-call" aria-label={`Обадете се на ${site.phoneDisplay}`}><i class="fa-solid fa-phone" aria-hidden="true"></i></a>
  </div>
</Layout>
