---
/**
 * Animated construction scene drawn as a technical drawing:
 * a residential frame building rises line by line, a tower crane assembles,
 * then windows light up and the crane keeps working in a loop.
 * All geometry is generated here so the markup stays compact and tweakable.
 */

const G = 780; // ground level (viewBox is 1600 × 900)

type Shape = { d: string; t: number; cls?: string };
const lines: Shape[] = []; // stroked, drawn in with stroke-dashoffset
const faint: Shape[] = []; // distant context, drawn in faintly
const windows: { x: number; y: number; w: number; h: number; t: number; dur: number; lit: boolean }[] = [];

// Deterministic pseudo-random so every build renders the same scene
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);

const seg = (x1: number, y1: number, x2: number, y2: number) => `M${x1} ${y1}L${x2} ${y2}`;
const box = (x: number, y: number, w: number, h: number) => `M${x} ${y}h${w}v${h}h${-w}Z`;

/* ---- Main building: 6 finished floors + a floor under construction ---- */
const bx = 560, bw = 360, bays = 6, fh = 62, floors = 6;
const bayW = bw / bays;
const top = G - floors * fh;

lines.push({ d: seg(0, G, 1600, G), t: 0.15 });
for (let c = 0; c <= bays; c++) lines.push({ d: seg(bx + c * bayW, G, bx + c * bayW, top), t: 0.45 + c * 0.06 });
for (let f = 1; f <= floors; f++) {
  const y = G - f * fh;
  lines.push({ d: `M${bx - 8} ${y}H${bx + bw + 8}`, t: 0.8 + f * 0.1 });
  lines.push({ d: `M${bx - 8} ${y + 7}H${bx + bw + 8}`, t: 0.85 + f * 0.1, cls: "ln-thin" });
}
// Floor under construction: shorter columns with rebar sticking out, formwork edge
for (let c = 0; c <= bays; c++) {
  const x = bx + c * bayW;
  lines.push({ d: seg(x, top, x, top - 34), t: 1.55 + c * 0.04 });
  lines.push({ d: `M${x - 3} ${top - 34}v-12M${x + 3} ${top - 34}v-12`, t: 1.75 + c * 0.04, cls: "ln-thin" });
}
lines.push({ d: `M${bx} ${top - 34}H${bx + bayW * 3}`, t: 1.9, cls: "ln-thin" });

// Scaffolding on the left face
for (let f = 0; f <= floors; f++) lines.push({ d: `M${bx - 36} ${G - f * fh}H${bx - 8}`, t: 1.1 + f * 0.05, cls: "ln-thin" });
lines.push({ d: seg(bx - 36, G, bx - 36, top - 20), t: 1.0, cls: "ln-thin" });
lines.push({ d: seg(bx - 22, G, bx - 22, top - 20), t: 1.05, cls: "ln-thin" });
for (let f = 0; f < floors; f++) {
  const y = G - f * fh;
  lines.push({ d: f % 2 ? seg(bx - 36, y, bx - 22, y - fh) : seg(bx - 22, y, bx - 36, y - fh), t: 1.2 + f * 0.05, cls: "ln-thin" });
}

// Windows in every bay of the finished floors
for (let f = 0; f < floors; f++) {
  for (let b = 0; b < bays; b++) {
    const x = bx + b * bayW + 14, y = G - (f + 1) * fh + 20, w = bayW - 28, h = fh - 30;
    lines.push({ d: box(x, y, w, h), t: 1.4 + f * 0.08 + b * 0.02, cls: "ln-thin" });
    windows.push({ x: x + 1, y: y + 1, w: w - 2, h: h - 2, t: 2.6 + rnd() * 1.6, dur: 6 + rnd() * 10, lit: rnd() > 0.45 });
  }
}

/* ---- Tower crane ---- */
const mx = 1000, mw = 18, jibY = 150;
lines.push({ d: seg(mx, G, mx, jibY), t: 1.2 });
lines.push({ d: seg(mx + mw, G, mx + mw, jibY), t: 1.25 });
let zig = `M${mx} ${G}`;
for (let y = G, k = 0; y > jibY; y -= 26, k++) zig += `L${k % 2 ? mx : mx + mw} ${y - 26}`;
lines.push({ d: zig, t: 1.4, cls: "ln-thin" });
// base / foundation
lines.push({ d: box(mx - 16, G - 10, mw + 32, 10), t: 1.15 });
// jib (over the building) and counter-jib
lines.push({ d: `M${bx - 10} ${jibY}H${mx + mw + 150}`, t: 1.9 });
lines.push({ d: `M${bx - 10} ${jibY + 12}H${mx}`, t: 1.95 });
let jz = `M${bx - 10} ${jibY + 12}`;
for (let x = bx - 10, k = 0; x < mx; x += 22, k++) jz += `L${Math.min(x + 22, mx)} ${k % 2 ? jibY + 12 : jibY}`;
lines.push({ d: jz, t: 2.05, cls: "ln-thin" });
lines.push({ d: `M${mx + mw} ${jibY + 10}H${mx + mw + 150}`, t: 2.0 });
// cat head + tie bars
lines.push({ d: `M${mx} ${jibY}L${mx + mw / 2} ${jibY - 46}L${mx + mw} ${jibY}`, t: 2.1 });
lines.push({ d: `M${mx + mw / 2} ${jibY - 46}L${bx + 60} ${jibY}`, t: 2.25, cls: "ln-thin" });
lines.push({ d: `M${mx + mw / 2} ${jibY - 46}L${mx + mw + 150} ${jibY}`, t: 2.25, cls: "ln-thin" });
// counterweight and cab
lines.push({ d: box(mx + mw + 108, jibY + 10, 42, 26), t: 2.3 });
lines.push({ d: box(mx + mw, jibY + 14, 22, 18), t: 2.3 });

/* ---- Dimension lines (technical drawing annotations) ---- */
const dimX = bx - 70;
lines.push({ d: `M${dimX} ${G}V${top}M${dimX - 6} ${G}h12M${dimX - 6} ${top}h12`, t: 2.4, cls: "ln-dim" });
lines.push({ d: `M${bx} ${G + 34}H${bx + bw}M${bx} ${G + 28}v12M${bx + bw} ${G + 28}v12`, t: 2.45, cls: "ln-dim" });

/* ---- Distant context (fainter): finished block on the right, low-rise + second crane on the left ---- */
const rx = 1200, rw = 300, rf = 9, rfh = 46;
faint.push({ d: box(rx, G - rf * rfh, rw, rf * rfh), t: 0.6 });
for (let f = 1; f < rf; f++) faint.push({ d: `M${rx} ${G - f * rfh}H${rx + rw}`, t: 0.7 + f * 0.04 });
for (let f = 0; f < rf; f++) {
  for (let b = 0; b < 6; b++) {
    const x = rx + 14 + b * 48, y = G - (f + 1) * rfh + 14;
    windows.push({ x, y, w: 22, h: 18, t: 2.2 + rnd() * 2, dur: 8 + rnd() * 12, lit: rnd() > 0.55 });
  }
}
[
  [60, 170, 5],
  [250, 150, 3],
  [410, 110, 7],
].forEach(([x, w, n], k) => {
  faint.push({ d: box(x, G - n * 40, w, n * 40), t: 0.5 + k * 0.1 });
  for (let f = 1; f < n; f++) faint.push({ d: `M${x} ${G - f * 40}H${x + w}`, t: 0.6 + k * 0.1 + f * 0.03 });
});
faint.push({ d: `M300 ${G}V360M312 ${G}V360M140 360H420M306 360L306 330L140 360`, t: 1.0 });

// Ground hatching (section symbol)
let hatch = "";
for (let x = 0; x < 1600; x += 18) hatch += `M${x} ${G + 2}l-12 12`;
---

<svg class="scene" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax meet" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="cone" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e8cf98" stop-opacity="0.35"></stop>
      <stop offset="1" stop-color="#e8cf98" stop-opacity="0"></stop>
    </linearGradient>
    <radialGradient id="glow">
      <stop offset="0" stop-color="#c8963e" stop-opacity="0.55"></stop>
      <stop offset="1" stop-color="#c8963e" stop-opacity="0"></stop>
    </radialGradient>
  </defs>

  <!-- warm dusk glow on the horizon -->
  <ellipse class="fadein" style="--t:0.2s" cx="800" cy={G} rx="760" ry="170" fill="url(#glow)"></ellipse>

  <path class="fadein ln-hatch" style="--t:0.4s" d={hatch}></path>

  <g class="ln-faint">
    {faint.map((s) => <path class="draw" pathLength="1" d={s.d} style={`--t:${s.t}s`} />)}
  </g>

  <!-- floodlight from the crane cab onto the site -->
  <path class="fadein cone" style="--t:2.8s" d={`M1016 ${jibY + 32}L700 ${G}H1010Z`} fill="url(#cone)"></path>

  <g class="win-layer">
    {
      windows.map((w) => (
        <rect
          class:list={["win", w.lit && "lit"]}
          x={w.x}
          y={w.y}
          width={w.w}
          height={w.h}
          style={`--t:${w.t.toFixed(2)}s;--dur:${w.dur.toFixed(1)}s`}
        />
      ))
    }
  </g>

  <g class="ln-main">
    {lines.map((s) => <path class:list={["draw", s.cls]} pathLength="1" d={s.d} style={`--t:${s.t}s`} />)}
  </g>

  <!-- trolley, cable and load keep moving after the scene is built -->
  <g class="trolley">
    <g class="fadein" style="--t:2.5s">
      <rect x="700" y={jibY + 12} width="18" height="7" class="solid"></rect>
      <line class="cable" x1="709" y1={jibY + 19} x2="709" y2="300"></line>
      <g class="hoist">
        <path class="ln-part" d="M703 300h12l-6 10z"></path>
        <path class="ln-part" d="M709 310v8M676 318h66M680 318l-8 14h74l-8-14"></path>
        <rect x="672" y="332" width="74" height="10" class="load"></rect>
      </g>
    </g>
  </g>

  <!-- aviation lights -->
  <circle class="blink" cx={bx - 8} cy={jibY} r="3.5"></circle>
  <circle class="blink" style="animation-delay:0.8s" cx={mx + mw / 2} cy={jibY - 46} r="3.5"></circle>

  <!-- dimension labels -->
  <g class="dim-text fadein" style="--t:2.7s">
    <text x={dimX - 12} y={top + 4} text-anchor="end">+{((floors * fh) / 20).toFixed(2)}</text>
    <text x={dimX - 12} y={G + 4} text-anchor="end">±0.00</text>
    <text x={bx + bw / 2} y={G + 58} text-anchor="middle">18.00</text>
  </g>
</svg>
