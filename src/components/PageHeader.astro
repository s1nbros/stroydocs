---
/** Compact header for content pages (the home page has its own header inside Hero). */
import { site } from "../data/site";
---

<header class="header is-static" id="site-header">
  <div class="header-bar">
    <a href="/" class="brand" aria-label={`${site.name} — начало`}>
      <img class="brand-logo" src="/brand/stroydocs-logo-dark.svg" alt="StroyDocs — КСС, актове, оферти" width="427" height="128" />
    </a>
    <nav class="nav" aria-label="Основна навигация">
      <a href="/">Начало</a>
      <a href="/#services">Услуги</a>
      <a href="/#pricing">Цени</a>
      <a href="/#contact">Контакти</a>
    </nav>
    <a href={site.phoneHref} class="nav-phone" aria-label={`Обадете се на ${site.phoneDisplay}`}>
      <span class="nav-phone-icon" aria-hidden="true"><i class="fa-solid fa-phone"></i></span>
      <span class="nav-phone-text"><small>Обадете се</small><b>{site.phoneDisplay}</b></span>
    </a>
  </div>
</header>
