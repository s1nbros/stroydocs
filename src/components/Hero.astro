---
import { heroStats, nav, site } from "../data/site";
import ConstructionScene from "./ConstructionScene.astro";
---

<!-- Entrance: shown once per session (html.play-intro is set by the inline script in Layout) -->
<div class="intro" aria-hidden="true">
  <div class="intro-half intro-top"></div>
  <div class="intro-half intro-bottom"></div>
  <div class="intro-center">
    <span class="intro-logo"><img src="/assets/logo.svg" alt="" width="40" height="40" /></span>
    <span class="intro-line"></span>
  </div>
</div>

<header class="header" id="site-header">
  <a href="#top" class="logo" aria-label={`${site.name} — начало`}>
    <img src="/assets/logo.svg" alt="" width="52" height="52" />
  </a>

  <nav class="nav" aria-label="Основна навигация">
    {nav.map((n, i) => <a href={n.href} class:list={[i === 0 && "is-active"]} data-spy={n.href}>{n.label}</a>)}
  </nav>

  <a href={site.phoneHref} class="sign-in">Обади се</a>

  <button class="burger" type="button" aria-label="Отвори менюто" aria-expanded="false" aria-controls="mobile-menu">
    <span></span><span></span><span></span>
  </button>
</header>

<!-- Kept outside the header: the header is transformed, which would trap fixed children -->
<div class="menu-overlay" hidden></div>
<nav class="mobile-menu" id="mobile-menu" aria-label="Мобилно меню" hidden>
  {
    nav.map((n, i) => (
      <a href={n.href} class:list={[i === 0 && "is-active"]} data-spy={n.href} style={`--i:${i}`}>
        {n.label}
      </a>
    ))
  }
  <a href={site.phoneHref} class="mobile-call" style={`--i:${nav.length}`}>Обади се: {site.phoneDisplay}</a>
</nav>

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="bg" aria-hidden="true">
    <div class="bg-grid"></div>
    <div class="ground-line"></div>
    <ConstructionScene />
    <div class="laser"></div>
  </div>

  <div class="page">
    <div class="header-spacer"></div>

    <div class="hero-main">
      <div class="trust anim" style="--d: 0.05s">
        <span class="trust-avatar a1"><span><i class="fa-solid fa-file-invoice" aria-hidden="true"></i></span></span>
        <span class="trust-avatar a2"><span><i class="fa-solid fa-stamp" aria-hidden="true"></i></span></span>
        <span class="trust-avatar a3"><span><i class="fa-solid fa-folder-open" aria-hidden="true"></i></span></span>
        <span class="trust-pill">Над 200 акта за софийски фирми</span>
      </div>

      <h1 class="headline anim" id="hero-title">
        <span>КСС и актове</span>
        <span>до <em>48</em> часа</span>
      </h1>

      <p class="subhead anim" style="--d: 0.28s">
        Вие строите. Ние правим документите. Изпратете количествена сметка или чертеж — оферта до 2 часа, готов документ
        до 48.
      </p>

      <a href="#contact" class="cta anim" style="--d: 0.4s">Изпрати файл <span class="btn-arrow" aria-hidden="true">→</span></a>
    </div>

    <ul class="stats" aria-label="Ключови цифри">
      {
        heroStats.map((s, i) => (
          <li class="anim" style={`--d: ${0.5 + i * 0.08}s`}>
            <span class="stat-icon" aria-hidden="true"><i class={s.icon}></i></span>
            <span
              class="stat-value"
              data-count={s.target}
              data-suffix={s.suffix}
              data-decimals={s.decimals}
              data-index={i}
            >
              {`${s.target.toFixed(s.decimals)}${s.suffix}`}
            </span>
            <span class="stat-label">{s.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
