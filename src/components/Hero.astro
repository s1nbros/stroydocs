---
import { heroStats, nav, site } from "../data/site";
import ConstructionScene from "./ConstructionScene.astro";
import { TextMorph } from "@/components/ui/text-morph";
import { AnnotatedText } from "@/components/ui/annotated-text";
import { LetterCascade } from "@/components/ui/letter-cascade";
---

<!-- Entrance: shown once per session (html.play-intro is set by the inline script in Layout) -->
<div class="intro" aria-hidden="true">
  <div class="intro-half intro-top"></div>
  <div class="intro-half intro-bottom"></div>
  <div class="intro-center">
    <span class="intro-logo"><img src="/assets/logo.svg" alt="" width="72" height="72" /></span>
    <span class="intro-line"></span>
  </div>
</div>

<header class="header" id="site-header">
  <div class="header-bar">
    <a href="#top" class="brand" aria-label={`${site.name} — начало`}>
      <span class="logo"><img src="/assets/logo.svg" alt="" width="52" height="52" /></span>
      <span class="brand-text">
        <b>{site.name}</b>
        <small>КСС · Актове · Оферти</small>
      </span>
    </a>

    <nav class="nav" aria-label="Основна навигация" data-nav>
      <span class="nav-indicator" aria-hidden="true"></span>
      {nav.map((n, i) => <a href={n.href} class:list={[i === 0 && "is-active"]} data-spy={n.href}>{n.label}</a>)}
    </nav>

    <a href={site.phoneHref} class="nav-phone" aria-label={`Обадете се на ${site.phoneDisplay}`}>
      <span class="nav-phone-icon" aria-hidden="true"><i class="fa-solid fa-phone"></i></span>
      <span class="nav-phone-text">
        <small>Обадете се</small>
        <b>{site.phoneDisplay}</b>
      </span>
    </a>

    <button class="burger" type="button" aria-label="Отвори менюто" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<!-- Kept outside the header: the header is transformed, which would trap fixed children -->
<div class="menu-overlay" hidden></div>
<nav class="mobile-menu" id="mobile-menu" aria-label="Мобилно меню" hidden>
  {
    nav.map((n, i) => (
      <a href={n.href} class:list={[i === 0 && "is-active"]} data-spy={n.href} style={`--i:${i}`}>
        {n.label}
      </a>
    ))
  }
  <a href={site.phoneHref} class="mobile-call" style={`--i:${nav.length}`}>Обади се: {site.phoneDisplay}</a>
</nav>

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="bg" aria-hidden="true">
    <div class="bg-grid"></div>
    <div class="ground-line"></div>
    <ConstructionScene />
    <div class="laser"></div>
  </div>

  <div class="page">
    <div class="header-spacer"></div>

    <div class="hero-main">
      <div class="trust anim" style="--d: 0.05s">
        <span class="trust-avatar a1"><span><i class="fa-solid fa-file-invoice" aria-hidden="true"></i></span></span>
        <span class="trust-avatar a2"><span><i class="fa-solid fa-stamp" aria-hidden="true"></i></span></span>
        <span class="trust-avatar a3"><span><i class="fa-solid fa-folder-open" aria-hidden="true"></i></span></span>
        <span class="trust-pill">Над 200 акта за софийски фирми</span>
      </div>

      <h1 class="headline" id="hero-title">
        <span class="hl-line"><span class="hl-morph"><TextMorph client:load words={["КСС", "Актове", "Оферти", "Търгове"]} interval={2200} morphDuration={720} /></span></span>
        <span class="hl-line"><span class="hl-split">до <em>48</em> часа</span></span>
      </h1>

      <p class="subhead anim" style="--d: 0.28s">
        Вие строите. Ние правим документите. Изпратете количествена сметка или чертеж —{" "}
        <span class="whitespace-nowrap"><AnnotatedText client:visible variant="wavy" color="text-[#c8963e]" delay={2.4}>оферта до 2 часа</AnnotatedText>,</span> готов документ до 48.
      </p>

      <a href="#contact" class="cta anim" style="--d: 0.4s"><LetterCascade client:visible text="Изпрати файл" /> <span class="btn-arrow" aria-hidden="true">→</span></a>
    </div>

    <ul class="stats" aria-label="Ключови цифри">
      {
        heroStats.map((s, i) => (
          <li class="anim" style={`--d: ${0.5 + i * 0.08}s`}>
            <span class="stat-icon" aria-hidden="true"><i class={s.icon}></i></span>
            <span
              class="stat-value"
              data-count={s.target}
              data-suffix={s.suffix}
              data-decimals={s.decimals}
              data-index={i}
            >
              {`${s.target.toFixed(s.decimals)}${s.suffix}`}
            </span>
            <span class="stat-label">{s.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
