---
import { otherPrices, pricingExamples, pricingKinds, pricingMin, pricingTiers, quote } from "../data/site";
import { Image } from "astro:assets";
import actsBinder from "../assets/acts-binder.jpg";

// Real project: КСС for the rough construction of a mixed-use complex in Mladost
const q0 = quote(640);
const fmtEur = (n: number) => `${Math.round(n).toLocaleString("bg-BG")} €`;
const fmtRate = (n: number) => `${n.toFixed(2).replace(".", ",")} €/м²`;
const caseStats = [
  { value: 4, suffix: "", decimals: 0, label: "сгради + основи" },
  { value: 222, suffix: "", decimals: 0, label: "позиции в КСС" },
  { value: 5.3, suffix: " млн.", decimals: 1, label: "евро — стойност на СМР" },
];
import Tape from "./Tape.astro";
import Heading from "./Heading.astro";
import { AnnotatedText } from "@/components/ui/annotated-text";
import { LetterCascade } from "@/components/ui/letter-cascade";
---

<!-- Case study -->
<Tape />
<section class="section surface-a" data-word="Казус" aria-labelledby="case-title">
  <div class="wrap">
    <p class="eyebrow" data-reveal>Казус · ж.к. „Младост“, София</p>
    <Heading id="case-title" class="max-w-4xl" text="КСС за четири сгради." dim="Груб строеж, готов за подаване." />

    <dl class="mt-14 grid grid-cols-3 border-y border-white/10">
      {
        caseStats.map((s, i) => (
          <div class="py-8 pr-3 [&:not(:first-child)]:border-l [&:not(:first-child)]:border-white/10 [&:not(:first-child)]:pl-4 sm:py-12 sm:[&:not(:first-child)]:pl-8" data-reveal style={`--i:${i}`}>
            <dt class="sr-only">{s.label}</dt>
            <dd class="font-display text-[clamp(26px,6vw,84px)] leading-none font-semibold whitespace-nowrap tabular-nums">
              <span data-count={s.value} data-suffix={s.suffix} data-decimals={s.decimals} data-scroll-count>
                {`${s.value.toFixed(s.decimals).replace(".", ",")}${s.suffix}`}
              </span>
            </dd>
            <dd class="mt-3 text-sm text-muted sm:text-base">{s.label}</dd>
          </div>
        ))
      }
    </dl>

    <figure class="mt-14 max-w-3xl" data-reveal>
      <!-- DRAFT: wording based on the project facts — get the client's approval before going live -->
      <blockquote class="text-[clamp(22px,2.8vw,34px)] leading-snug font-medium tracking-[-0.02em]">
        „Изпратихме чертежите за четирите сгради и основите. Получихме КСС с 222 позиции — кофраж, армировка и бетон,
        разписани по коти, с рекапитулация по раздели. Подадохме офертата към възложителя директно.“
      </blockquote>
      <figcaption class="mt-6 text-muted">— „ЧИВИ СТРОЙ“ ЕООД, сграда със смесено предназначение, ж.к. „Младост“</figcaption>
    </figure>

    <div class="mt-16 grid items-center gap-8 lg:grid-cols-[1.1fr_1fr] lg:gap-14">
      <div class="tilt" data-tilt data-reveal-photo>
      <figure class="photo-card">
        <Image src={actsBinder} alt="Папка с подредени актове 12, 14, 19 и 15, готови за подпис" widths={[480, 800, 1100]} sizes="(min-width: 1024px) 50vw, 100vw" loading="lazy" decoding="async" />
        <figcaption>Папка „Акт 15“ — подредена и проверена</figcaption>
      </figure>
      </div>
      <div data-reveal style="--i:1">
      <p class="font-display text-[clamp(52px,7vw,88px)] leading-none">200+</p>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-[#a9b3c2]">
        изготвени акта и над 40 КСС за строителни изпълнители. Познаваме Наредба №3 и какво гледат техническият контрол и
        инвеститорите — документите минават <AnnotatedText client:visible variant="highlight" color="text-[#c8963e]/35" delay={0.5}>от първия път</AnnotatedText>.
      </p>
      </div>
    </div>
  </div>
</section>

<!-- Pricing -->
<Tape variant="cross" text="Ясни цени · Без скрити такси · Корекции безплатно" />
<section class="section surface-b" data-word="Цени" id="pricing" aria-labelledby="pricing-title">
  <div class="wrap">
    <p class="eyebrow" data-reveal>Цени</p>
    <Heading id="pricing-title" text="Цена на квадрат." dim="Колкото по-голям обектът — толкова по-ниска." />
    <p class="lead" data-reveal style="--i:2">
      Скàлата е <AnnotatedText client:visible variant="circle" color="text-[#c8963e]" delay={0.6}>прогресивна</AnnotatedText> — като данъчните ставки. Всеки следващ диапазон квадратура се смята по по-ниска цена: средната цена на квадрат пада, а общата сума винаги расте с площта.
    </p>

    <div class="mt-14 grid items-start gap-6 lg:grid-cols-[1.25fr_1fr]">
      <!-- Base rates -->
      <div class="price-table" data-reveal data-price-table role="table" aria-label="Базови ставки по РЗП">
        <div class="price-head" role="row">
          <span role="columnheader">Диапазон от РЗП</span>
          <span role="columnheader">КСС самостоятелно, за всеки м²</span>
          <span role="columnheader">Пълен пакет, за всеки м²</span>
        </div>
        {
          pricingTiers.map((t, i) => (
            <div class="price-row" role="row" data-tier={i} data-spot style={`--i:${i}`}>
              <span role="cell" class="price-area">{t.label}</span>
              <span role="cell">
                <b>{t.kss.toFixed(2).replace(".", ",")} €/м²</b>
                <i class="price-bar" style={`--w:${((t.kss / 5.0) * 100).toFixed(1)}%`} />
              </span>
              <span role="cell">
                <b>{t.full.toFixed(2).replace(".", ",")} €/м²</b>
                <i class="price-bar accent" style={`--w:${((t.full / 5.0) * 100).toFixed(1)}%`} />
              </span>
            </div>
          ))
        }
        <div class="price-notes">
          <p><b>Как се смята:</b> 640 м² = 150 м² × 2,50 + 250 м² × 2,00 + 240 м² × 1,60 = 1 259 € за КСС.</p>
          <p><b>Минимална поръчка:</b> {pricingMin.kss} € за КСС · {pricingMin.full} € за пълен пакет.</p>
        </div>
      </div>

      <!-- Live calculator -->
      <div class="calc" data-reveal style="--i:2" data-calc>
        <p class="text-sm font-medium text-muted">Изчислете за вашия обект</p>
        <label for="calc-area" class="mt-5 flex items-baseline justify-between gap-4">
          <span class="text-[15px] font-medium">РЗП на обекта</span>
          <output class="calc-area" for="calc-area" data-calc-area>640 м²</output>
        </label>
        <input id="calc-area" type="range" min="30" max="3000" step="10" value="640" class="calc-range" data-calc-input />
        <div class="mt-5 flex flex-wrap gap-2" role="group" aria-label="Примери">
          {
            pricingExamples.map((e) => (
              <button type="button" class="calc-chip" data-calc-set={e.area}>
                {e.label} · {e.area} м²
              </button>
            ))
          }
        </div>
        <p class="mt-6 text-[15px] font-medium">Вид обект</p>
        <div class="mt-3 flex flex-wrap gap-2" role="radiogroup" aria-label="Вид обект">
          {
            pricingKinds.map((k, i) => (
              <button type="button" role="radio" aria-checked={i === 0 ? "true" : "false"} class:list={["calc-chip", i === 0 && "is-active"]} data-calc-kind={k.k}>
                {k.label}
              </button>
            ))
          }
        </div>
        <dl class="mt-8 grid grid-cols-2 gap-3" aria-live="polite">
          <div class="calc-out">
            <dt>КСС</dt>
            <dd data-calc-kss>{fmtEur(q0.kss)}</dd>
            <span data-calc-kss-rate>средно {fmtRate(q0.avgKss)}</span>
          </div>
          <div class="calc-out accent">
            <dt>Пълен пакет</dt>
            <dd data-calc-full>{fmtEur(q0.full)}</dd>
            <span data-calc-full-rate>средно {fmtRate(q0.avgFull)}</span>
          </div>
        </dl>
        <p class="calc-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> Ориентировъчно. Точната цена зависи от вида на обекта и обхвата.</p>
        <a href="#contact" class="btn-white mt-6 w-full"><LetterCascade client:visible text="Поискай точна оферта" /> <span class="btn-arrow" aria-hidden="true">→</span></a>
      </div>
    </div>

    <h3 class="mt-20 text-sm font-medium text-muted" data-reveal>Други услуги</h3>
    <div class="mt-4 border-t border-white/10">
      {
        otherPrices.map((p, i) => (
          <div class="price-other flex flex-col gap-1 border-b border-white/10 py-5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8" data-reveal data-spot style={`--i:${i}`}>
            <div>
              <p class="text-[clamp(18px,1.8vw,21px)] font-semibold tracking-[-0.02em]">{p.item}</p>
              <p class="mt-1 text-[15px] text-muted">{p.note}</p>
            </div>
            <p class="shrink-0 font-display text-[clamp(22px,2.4vw,28px)] font-semibold">{p.price}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-[15px] text-muted" data-reveal>Цените са без ДДС. Корекциите по същия обект са безплатни.</p>
  </div>
</section>
