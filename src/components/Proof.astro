---
import { otherPrices, pricingExamples, pricingMin, pricingTiers } from "../data/site";
import { Image } from "astro:assets";
import actsBinder from "../assets/acts-binder.jpg";

// Real project: КСС for the rough construction of a mixed-use complex in Mladost (source: offer PDF, 10 pages)
const caseStats = [
  { value: 222, suffix: "", label: "позиции в КСС" },
  { value: 111711, suffix: " м²", label: "кофраж" },
  { value: 32672, suffix: " м³", label: "бетон" },
  { value: 3723, suffix: " т", label: "армировка" },
];
const caseSections = [
  { name: "Етап 0 — Основи (фундаменти)", value: 614081.24, share: 11.5 },
  { name: "Сграда 1 — блок „Офиси“", value: 1179207.92, share: 22.1 },
  { name: "Сграда 2 — вход „А“", value: 1036027.84, share: 19.5 },
  { name: "Сграда 3 — вход „Б“", value: 1291169.11, share: 24.2 },
  { name: "Сграда 4 — вход „В“", value: 1204963.72, share: 22.6 },
];
const eur = (n: number) => n.toLocaleString("bg-BG", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " €";
import Tape from "./Tape.astro";
import Heading from "./Heading.astro";
import { AnnotatedText } from "@/components/ui/annotated-text";
import { LetterCascade } from "@/components/ui/letter-cascade";
---

<!-- Case study -->
<Tape />
<section class="section surface-a" data-word="Казус" aria-labelledby="case-title">
  <div class="wrap">
    <p class="eyebrow" data-reveal>Казус · ж.к. „Младост“, София</p>
    <Heading id="case-title" class="max-w-4xl" text="КСС за груб строеж на четири сгради." dim="222 позиции за 5,3 милиона евро." />
    <p class="lead max-w-3xl" data-reveal>
      Сграда със смесено предназначение — офиси, жилищни входове „А“, „Б“ и „В“, магазини, трафопост и подземен гараж.
      Изготвихме пълната КСС за кофражни, армировъчни и бетонови работи на{" "}
      <strong class="font-semibold text-white">„ЧИВИ СТРОЙ“ ЕООД</strong> — от фундаментната плоча до кота +46.13.
    </p>

    <dl class="mt-14 grid grid-cols-2 border-y border-white/10 lg:grid-cols-4">
      {
        caseStats.map((s, i) => (
          <div class="border-white/10 py-8 pr-3 max-lg:[&:nth-child(n+3)]:border-t lg:[&:not(:first-child)]:border-l lg:[&:not(:first-child)]:pl-8 max-lg:[&:nth-child(even)]:border-l max-lg:[&:nth-child(even)]:pl-5 sm:py-12" data-reveal style={`--i:${i}`}>
            <dt class="sr-only">{s.label}</dt>
            <dd class="font-display text-[clamp(28px,4vw,52px)] leading-none font-semibold whitespace-nowrap tabular-nums">
              <span data-count={s.value} data-suffix={s.suffix} data-decimals="0" data-group data-scroll-count>
                {`${s.value.toLocaleString("bg-BG")}${s.suffix}`}
              </span>
            </dd>
            <dd class="mt-3 text-sm text-muted sm:text-base">{s.label}</dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-14 grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:gap-14">
      <div class="case-breakdown" data-reveal data-case-bars>
        <p class="text-sm font-medium text-muted">Рекапитулация по раздели</p>
        <ul class="mt-5 grid gap-5">
          {
            caseSections.map((c, i) => (
              <li style={`--i:${i}`}>
                <div class="flex items-baseline justify-between gap-4">
                  <span class="text-[16px] text-[#d3d9e2]">{c.name}</span>
                  <span class="font-display text-[18px] font-semibold whitespace-nowrap tabular-nums">{eur(c.value)}</span>
                </div>
                <div class="case-bar mt-2"><i style={`--w:${(c.share / 24.2) * 100}%`} /><b>{c.share.toLocaleString("bg-BG")}%</b></div>
              </li>
            ))
          }
        </ul>
        <div class="mt-7 flex flex-wrap items-baseline justify-between gap-3 border-t border-white/10 pt-5">
          <span class="text-muted">Общо без ДДС · с ДДС 20%</span>
          <span class="font-display text-[clamp(22px,2.4vw,30px)] font-semibold tabular-nums">5 325 449,83 € <span class="text-muted">· 6 390 539,80 €</span></span>
        </div>
      </div>

      <div data-reveal style="--i:1">
        <p class="text-sm font-medium text-muted">Какво съдържа документът</p>
        <ul class="mt-5 grid gap-3 text-[16px] text-[#c7cfdb]">
          {
            [
              "Етап „Основи“ + 4 сгради, всяка по кофраж, бетон и армировка",
              "Позиция по позиция за всяка плоча — от кота -8.10 до +46.13",
              "Бетон C30/37, количества в м², м³ и кг",
              "Рекапитулация, междинни суми, ДДС и непредвидени разходи",
              "Условия: обхват, плащане с Акт 19, инфлационна клауза, валидност",
            ].map((t) => (
              <li class="flex gap-3">
                <i class="fa-solid fa-check mt-1 text-[#c8963e]" aria-hidden="true" />
                {t}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-16 grid items-center gap-8 lg:grid-cols-[1.1fr_1fr] lg:gap-14">
      <div class="tilt" data-tilt data-reveal-photo>
      <figure class="photo-card">
        <Image src={actsBinder} alt="Папка с подредени актове 12, 14, 19 и 15, готови за подпис" widths={[480, 800, 1100]} sizes="(min-width: 1024px) 50vw, 100vw" loading="lazy" decoding="async" />
        <figcaption>Папка „Акт 15“ — подредена и проверена</figcaption>
      </figure>
      </div>
      <div data-reveal style="--i:1">
      <p class="font-display text-[clamp(52px,7vw,88px)] leading-none">200+</p>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-[#a9b3c2]">
        изготвени акта и над 40 КСС за софийски изпълнители. Познаваме Наредба №3 и какво гледат техническият контрол и
        инвеститорите — документите минават <AnnotatedText client:visible variant="highlight" color="text-[#c8963e]/35" delay={0.5}>от първия път</AnnotatedText>.
      </p>
      </div>
    </div>
  </div>
</section>

<!-- Pricing -->
<Tape variant="cross" text="Ясни цени · Без скрити такси · Корекции безплатно" />
<section class="section surface-b" data-word="Цени" id="pricing" aria-labelledby="pricing-title">
  <div class="wrap">
    <p class="eyebrow" data-reveal>Цени</p>
    <Heading id="pricing-title" text="Цена на квадрат." dim="Колкото по-голям обектът — толкова по-ниска." />
    <p class="lead" data-reveal style="--i:2">
      Скàлата е <AnnotatedText client:visible variant="circle" color="text-[#c8963e]" delay={0.6}>низходяща</AnnotatedText> — при голям обект цената на квадрат пада, но общата сума расте значително.
    </p>

    <div class="mt-14 grid items-start gap-6 lg:grid-cols-[1.25fr_1fr]">
      <!-- Base rates -->
      <div class="price-table" data-reveal data-price-table role="table" aria-label="Базови ставки по РЗП">
        <div class="price-head" role="row">
          <span role="columnheader">Площ (РЗП)</span>
          <span role="columnheader">КСС самостоятелно</span>
          <span role="columnheader">Пълен документален пакет</span>
        </div>
        {
          pricingTiers.map((t, i) => (
            <div class="price-row" role="row" data-tier={i} data-spot style={`--i:${i}`}>
              <span role="cell" class="price-area">{t.label}</span>
              <span role="cell">
                <b>{t.kss.toFixed(2).replace(".", ",")} €/м²</b>
                {i === 0 && <small> (мин. {pricingMin.kss} €)</small>}
                <i class="price-bar" style={`--w:${((t.kss / 5.0) * 100).toFixed(1)}%`} />
              </span>
              <span role="cell">
                <b>{t.full.toFixed(2).replace(".", ",")} €/м²</b>
                {i === 0 && <small> (мин. {pricingMin.full} €)</small>}
                <i class="price-bar accent" style={`--w:${((t.full / 5.0) * 100).toFixed(1)}%`} />
              </span>
            </div>
          ))
        }
      </div>

      <!-- Live calculator -->
      <div class="calc" data-reveal style="--i:2" data-calc>
        <p class="text-sm font-medium text-muted">Изчислете за вашия обект</p>
        <label for="calc-area" class="mt-5 flex items-baseline justify-between gap-4">
          <span class="text-[15px] font-medium">РЗП на обекта</span>
          <output class="calc-area" for="calc-area" data-calc-area>640 м²</output>
        </label>
        <input id="calc-area" type="range" min="30" max="3000" step="10" value="640" class="calc-range" data-calc-input />
        <div class="mt-5 flex flex-wrap gap-2" role="group" aria-label="Примери">
          {
            pricingExamples.map((e) => (
              <button type="button" class="calc-chip" data-calc-set={e.area}>
                {e.label} · {e.area} м²
              </button>
            ))
          }
        </div>
        <dl class="mt-8 grid grid-cols-2 gap-3" aria-live="polite">
          <div class="calc-out">
            <dt>КСС</dt>
            <dd data-calc-kss>1 024 €</dd>
            <span data-calc-kss-rate>1,60 €/м²</span>
          </div>
          <div class="calc-out accent">
            <dt>Пълен пакет</dt>
            <dd data-calc-full>2 240 €</dd>
            <span data-calc-full-rate>3,50 €/м²</span>
          </div>
        </dl>
        <a href="#contact" class="btn-white mt-6 w-full"><LetterCascade client:visible text="Поискай точна оферта" /> <span class="btn-arrow" aria-hidden="true">→</span></a>
      </div>
    </div>

    <h3 class="mt-20 text-sm font-medium text-muted" data-reveal>Други услуги</h3>
    <div class="mt-4 border-t border-white/10">
      {
        otherPrices.map((p, i) => (
          <div class="price-other flex flex-col gap-1 border-b border-white/10 py-5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8" data-reveal data-spot style={`--i:${i}`}>
            <div>
              <p class="text-[clamp(18px,1.8vw,21px)] font-semibold tracking-[-0.02em]">{p.item}</p>
              <p class="mt-1 text-[15px] text-muted">{p.note}</p>
            </div>
            <p class="shrink-0 font-display text-[clamp(22px,2.4vw,28px)] font-semibold">{p.price}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-[15px] text-muted" data-reveal>Цените са без ДДС. Корекциите по същия обект са безплатни.</p>
  </div>
</section>
