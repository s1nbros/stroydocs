---
import { services } from "../data/site";
import BigMarquee from "./BigMarquee.astro";

const pains = [
  "Оферта до петък, а чертежите са 40 листа.",
  "Техническият контрол връща акта за корекция.",
  "Количествата в Акт 19 не съвпадат с КСС — плащането се бави.",
];
import Tape from "./Tape.astro";
import Heading from "./Heading.astro";
---

<BigMarquee words={["КСС", "Актове", "Оферти", "Търгове", "Документален офис"]} />

<!-- The problem -->
<section class="section surface-a" data-word="Проблемът" aria-labelledby="pain-title">
  <div class="wrap">
    <p class="eyebrow" data-reveal>Познато ли ви е?</p>
    <h2 id="pain-title" class="sr-only">Проблемът</h2>
    <div class="mt-10 grid gap-5">
      {
        pains.map((p, i) => (
          <p data-reveal style={`--i:${i}`} class="text-[clamp(30px,5vw,60px)] leading-[1.08] font-semibold tracking-[-0.04em] text-[#97a2b3]">
            <span class="strike">{p}</span>
          </p>
        ))
      }
    </div>
  </div>
</section>

<!-- Services -->
<Tape />
<section class="section surface-b" data-word="Услуги" id="services" aria-labelledby="services-title">
  <div class="wrap">
    <p class="eyebrow" data-reveal>Какво правим</p>
    <Heading id="services-title" text="Четири услуги." dim="Една цел — да не губите време." />

    <div class="relative mt-14 border-t border-white/10" data-svc-list>
      <!-- Floating document preview that follows the cursor over the rows (desktop only) -->
      <div class="svc-preview" aria-hidden="true">
        {
          services.map((s, i) => (
            <div class="svc-doc" data-svc-doc={i}>
              <p class="doc-card-kicker">StroyDocs</p>
              <p class="svc-doc-title">{s.preview}</p>
              <div class="doc-card-lines">
                <i style="width:90%" />
                <i style="width:70%" />
                <i style="width:82%" />
                <i style="width:55%" />
                <i style="width:76%" />
              </div>
              <span class="svc-doc-stamp">ГОТОВО</span>
            </div>
          ))
        }
      </div>
      {
        services.map((s, i) => (
          <a href="#contact" class="service-row group" data-reveal data-spot data-svc={i} style={`--i:${i}`}>
            <span class="service-icon" aria-hidden="true"><i class={s.icon} /></span>
            <span>
              <span class="block text-[clamp(24px,2.6vw,32px)] font-semibold tracking-[-0.03em]">{s.title}</span>
              <span class="mt-1 block text-sm text-muted">{s.tag}</span>
            </span>
            <span class="col-span-2 text-[17px] leading-relaxed text-[#a9b3c2] min-[900px]:col-span-1">{s.text}</span>
            <span class="col-span-2 flex items-center gap-3 text-[19px] font-semibold whitespace-nowrap min-[900px]:col-span-1 min-[900px]:justify-end">
              {s.price}
              <span class="btn-arrow text-white/50" aria-hidden="true">→</span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
