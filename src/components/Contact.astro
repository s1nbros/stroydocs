---
import { FORMSPREE_ENDPOINT, faq, projectTypes, site } from "../data/site";
import BigMarquee from "./BigMarquee.astro";
import Tape from "./Tape.astro";
---

<!-- Free checklist -->
<section class="section surface-a" data-word="Безплатно" aria-labelledby="checklist-title">
  <div class="wrap">
    <div class="checklist-card relative grid items-center gap-8 overflow-hidden rounded-[32px] p-8 sm:p-14 lg:grid-cols-2" data-reveal data-spot>
      <div aria-hidden="true" class="pointer-events-none absolute -right-10 -bottom-16 font-display text-[240px] leading-none font-bold text-white/[0.04] select-none">15</div>
      <div class="relative">
        <p class="text-sm font-medium text-accent-soft">Безплатно</p>
        <h2 id="checklist-title" class="mt-3 text-[clamp(30px,3.6vw,44px)] leading-[1.05] font-semibold tracking-[-0.04em]">
          Чеклист: всички документи за папка Акт 15
        </h2>
        <p class="mt-4 text-lg text-[#a8a8a8]">Една страница. Отметнете и вижте какво липсва — преди да дойде комисията.</p>
      </div>
      <form class="relative flex flex-col gap-3 sm:flex-row" data-form action={FORMSPREE_ENDPOINT} method="POST">
        <input type="hidden" name="_subject" value="Заявка за чеклист Акт 15" />
        <label for="checklist-email" class="sr-only">Имейл адрес</label>
        <input
          id="checklist-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="вашият@имейл.bg"
          class="field min-h-[56px] flex-1 !rounded-full px-6"
        />
        <button type="submit" class="btn-accent">Изпрати ми го <span class="btn-arrow" aria-hidden="true">→</span></button>
        <p class="form-status text-sm sm:absolute sm:top-full sm:mt-3" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<!-- FAQ -->
<Tape />
<section class="section surface-b" data-word="Въпроси" aria-labelledby="faq-title">
  <div class="wrap grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
    <div>
      <p class="eyebrow" data-reveal>Въпроси</p>
      <h2 id="faq-title" class="h2" data-reveal style="--i:1">Често <span class="dim">питат.</span></h2>
    </div>
    <div class="faq border-t border-white/10" data-reveal style="--i:2">
      {
        faq.map((f) => (
          <details data-spot>
            <summary>
              {f.q}
              <span class="plus" aria-hidden="true" />
            </summary>
            <p class="answer">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<BigMarquee words={["Изпратете файла", "Оферта до 2 часа", "Готово до 48 часа"]} reverse />

<!-- Contact -->
<section class="section surface-a" data-word="Контакт" id="contact" aria-labelledby="contact-title">
  <div class="wrap grid items-start gap-14 lg:grid-cols-2">
    <div>
      <p class="eyebrow" data-reveal>Запитване</p>
      <h2 id="contact-title" class="h2" data-reveal style="--i:1">
        Изпратете файла. <span class="dim">Цената е до 2 часа.</span>
      </h2>
      <p class="lead" data-reveal style="--i:2">Четири полета. Без регистрация. Или просто се обадете или пишете във Viber.</p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap" data-reveal style="--i:3">
        <a href={site.phoneHref} class="btn-white text-[17px]">
          <i class="fa-solid fa-phone" aria-hidden="true"></i>
          {site.phoneDisplay}
        </a>
        <a href={site.viberHref} class="btn-dark text-[17px]">
          <i class="fa-brands fa-viber" aria-hidden="true"></i> Viber
        </a>
        <a href={site.whatsappHref} class="btn-dark text-[17px]" target="_blank" rel="noopener">
          <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> WhatsApp
        </a>
      </div>
      <p class="mt-8 text-[15px] text-muted" data-reveal style="--i:4">
        Пон–пет, 08:00–18:00 · <a href={`mailto:${site.email}`} class="underline decoration-white/30 underline-offset-4 hover:text-white">{site.email}</a>
      </p>
    </div>

    <form
      class="grid gap-5 rounded-[28px] border border-white/10 bg-[#0b0b0c] p-6 sm:p-10"
      data-form
      data-reveal
      style="--i:2"
      action={FORMSPREE_ENDPOINT}
      method="POST"
      enctype="multipart/form-data"
    >
      <input type="hidden" name="_subject" value="Ново запитване" />
      <div>
        <label for="f-name" class="mb-2 block text-sm font-medium">Име</label>
        <input id="f-name" name="name" required autocomplete="name" class="field" placeholder="Иван Петров" />
      </div>
      <div>
        <label for="f-phone" class="mb-2 block text-sm font-medium">Телефон</label>
        <input id="f-phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" class="field" placeholder="088 123 4567" />
      </div>
      <div>
        <label for="f-type" class="mb-2 block text-sm font-medium">Тип обект</label>
        <select id="f-type" name="project_type" required class="field">
          <option value="" disabled selected>Изберете…</option>
          {projectTypes.map((t) => <option>{t}</option>)}
        </select>
      </div>
      <div>
        <span class="mb-2 block text-sm font-medium">Файл <span class="font-normal text-muted">(по желание)</span></span>
        <label class="field file-drop">
          <i class="fa-solid fa-arrow-up-from-bracket text-white" aria-hidden="true"></i>
          <span class="file-name truncate">КСС, чертеж или снимка</span>
          <input type="file" name="file" class="sr-only" accept=".pdf,.xls,.xlsx,.dwg,.jpg,.jpeg,.png,.zip" aria-label="Прикачи файл (по желание)" />
        </label>
      </div>
      <button type="submit" class="btn-white mt-2 w-full !min-h-[58px] text-[17px]">
        Изпрати запитване <span class="btn-arrow" aria-hidden="true">→</span>
      </button>
      <p class="form-status text-center text-sm" role="status" aria-live="polite"></p>
      <p class="flex items-center justify-center gap-2 text-sm text-muted">
        <i class="fa-regular fa-clock" aria-hidden="true"></i> Отговаряме до 2 часа в работен ден.
      </p>
    </form>
  </div>
</section>

<footer class="relative z-[2] border-t border-white/10 bg-black">
  <div class="wrap flex flex-col gap-8 py-12 sm:flex-row sm:items-center sm:justify-between">
    <a href="#top" class="flex items-center gap-3 text-lg font-semibold tracking-tight">
      <span class="grid h-10 w-10 place-items-center rounded-full bg-white"><img src="/assets/logo.svg" alt="" width="28" height="28" /></span>
      {site.name}
    </a>
    <p class="text-sm text-muted">Строителна документация за изпълнители · {site.city}</p>
    <a href={site.phoneHref} class="text-lg font-semibold">{site.phoneDisplay}</a>
  </div>
  <p class="wrap border-t border-white/10 py-6 text-xs text-white/35">© {new Date().getFullYear()} {site.name}. Всички права запазени.</p>
</footer>

<div class="fab">
  <a href={site.viberHref} class="fab-viber" aria-label="Пишете ни във Viber"><i class="fa-brands fa-viber" aria-hidden="true"></i></a>
  <a href={site.phoneHref} class="fab-call" aria-label={`Обадете се на ${site.phoneDisplay}`}><i class="fa-solid fa-phone" aria-hidden="true"></i></a>
</div>
