---
import { FORMSPREE_ENDPOINT, checklistStages, faq, projectTypes, site } from "../data/site";
import BigMarquee from "./BigMarquee.astro";
import Tape from "./Tape.astro";
import Heading from "./Heading.astro";
import { AnnotatedText } from "@/components/ui/annotated-text";
import { LetterCascade } from "@/components/ui/letter-cascade";
---

<!-- Free checklist: interactive, no sign-up (state kept in the browser) -->
<section class="section surface-a" data-word="Безплатно" aria-labelledby="checklist-title">
  <div class="wrap">
    <div class="checklist-card relative overflow-hidden rounded-[32px] p-6 sm:p-12" data-reveal data-checklist>
      <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:gap-12">
        <div class="relative">
          <p class="text-sm font-medium text-accent-soft">Безплатен инструмент</p>
          <h2 id="checklist-title" class="mt-3 font-display text-[clamp(30px,3.6vw,46px)] leading-[1.08] font-semibold">
            Чеклист за строителната документация
          </h2>
          <p class="mt-4 text-lg text-[#a9b3c2]">
            Изберете етапа и отметнете какво вече имате — веднага виждате какво липсва. Без регистрация, отметките остават в браузъра ви.
          </p>

          <div class="checklist-progress mt-8" aria-live="polite">
            <div class="flex items-baseline justify-between gap-4">
              <span class="text-[15px] font-medium" data-cl-title>{checklistStages[0].title}</span>
              <span class="font-display text-[22px] font-semibold tabular-nums"><span data-cl-done>0</span> / <span data-cl-total>{checklistStages[0].items.length}</span></span>
            </div>
            <div class="checklist-bar mt-3"><i data-cl-bar></i></div>
            <p class="mt-3 text-sm text-[#a9b3c2]" data-cl-status>Отметнете документите, които имате.</p>
          </div>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#contact" class="btn-accent" data-cl-cta>Липсва ми документ <span class="btn-arrow" aria-hidden="true">→</span></a>
            <button type="button" class="btn-dark" data-cl-print><i class="fa-solid fa-print" aria-hidden="true"></i> Отпечатай</button>
          </div>
        </div>

        <div>
          <div class="checklist-tabs" role="tablist" aria-label="Етап на строежа">
            {
              checklistStages.map((st, i) => (
                <button type="button" role="tab" id={`cl-tab-${st.id}`} aria-controls={`cl-panel-${st.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} class:list={["checklist-tab", i === 0 && "is-active"]} data-cl-tab={st.id}>
                  {st.label}
                </button>
              ))
            }
          </div>
          {
            checklistStages.map((st, i) => (
              <ul class="checklist-list" role="tabpanel" id={`cl-panel-${st.id}`} aria-labelledby={`cl-tab-${st.id}`} data-cl-panel={st.id} data-cl-title-text={st.title} hidden={i !== 0}>
                {st.items.map((item, j) => (
                  <li>
                    <label class="checklist-item">
                      <input type="checkbox" data-cl-item={`${st.id}-${j}`} />
                      <span class="checklist-box" aria-hidden="true"><i class="fa-solid fa-check" /></span>
                      <span class="checklist-text">{item}</span>
                    </label>
                  </li>
                ))}
              </ul>
            ))
          }
          <p class="mt-4 text-[13px] text-[#8a96a8]">
            Ориентировъчен списък. Точните документи зависят от категорията на строежа, проекта и изискванията на възложителя.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<Tape />
<section class="section surface-b" data-word="Въпроси" aria-labelledby="faq-title">
  <div class="wrap grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
    <div>
      <p class="eyebrow" data-reveal>Въпроси</p>
      <Heading id="faq-title" text="Какво питат хората" dim="най-често." />
    </div>
    <div class="faq border-t border-white/10" data-reveal style="--i:2">
      {
        faq.map((f) => (
          <details data-spot>
            <summary>
              {f.q}
              <span class="plus" aria-hidden="true" />
            </summary>
            <p class="answer">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<BigMarquee words={["Изпратете файла", "Оферта до 2 часа", "Готово до 48 часа"]} reverse />

<!-- Contact -->
<section class="section surface-a" data-word="Контакт" id="contact" aria-labelledby="contact-title">
  <div class="wrap grid items-start gap-14 lg:grid-cols-2">
    <div>
      <p class="eyebrow" data-reveal>Запитване</p>
      <Heading id="contact-title" text="Изпратете файла." dim="Цената е до 2 часа." />
      <p class="lead" data-reveal style="--i:2">Четири полета. Без регистрация. Или просто се обадете или пишете във Viber.</p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap" data-reveal style="--i:3">
        <a href={site.phoneHref} class="btn-white text-[17px]">
          <i class="fa-solid fa-phone" aria-hidden="true"></i>
          {site.phoneDisplay}
        </a>
        <a href={site.viberHref} class="btn-dark text-[17px]" data-viber>
          <i class="fa-brands fa-viber" aria-hidden="true"></i> Viber
        </a>
        <a href={site.whatsappHref} class="btn-dark text-[17px]" target="_blank" rel="noopener">
          <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> WhatsApp
        </a>
      </div>
      <p class="mt-8 text-[15px] text-muted" data-reveal style="--i:4">
        Пон–пет, 08:00–18:00 · <a href={`mailto:${site.email}`} class="underline decoration-white/30 underline-offset-4 hover:text-white">{site.email}</a>
      </p>
    </div>

    <form
      class="grid gap-5 rounded-[28px] border border-white/10 bg-[#0d1522] p-6 sm:p-10"
      data-form
      data-reveal
      style="--i:2"
      action={FORMSPREE_ENDPOINT}
      method="POST"
      enctype="multipart/form-data"
    >
      <input type="hidden" name="_subject" value="Ново запитване" />
      <div>
        <label for="f-name" class="mb-2 block text-sm font-medium">Име</label>
        <input id="f-name" name="name" required autocomplete="name" class="field" placeholder="Иван Петров" />
      </div>
      <div>
        <label for="f-phone" class="mb-2 block text-sm font-medium">Телефон</label>
        <input id="f-phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" class="field" placeholder="088 123 4567" />
      </div>
      <div>
        <label for="f-type" class="mb-2 block text-sm font-medium">Тип обект</label>
        <select id="f-type" name="project_type" required class="field">
          <option value="" disabled selected>Изберете…</option>
          {projectTypes.map((t) => <option>{t}</option>)}
        </select>
      </div>
      <div>
        <span class="mb-2 block text-sm font-medium">Файл <span class="font-normal text-muted">(по желание)</span></span>
        <label class="field file-drop">
          <i class="fa-solid fa-arrow-up-from-bracket text-white" aria-hidden="true"></i>
          <span class="file-name truncate">КСС, чертеж или снимка</span>
          <input type="file" name="file" class="sr-only" accept=".pdf,.xls,.xlsx,.dwg,.jpg,.jpeg,.png,.zip" aria-label="Прикачи файл (по желание)" />
        </label>
      </div>
      <button type="submit" class="btn-white mt-2 w-full !min-h-[58px] text-[17px]">
        <LetterCascade client:visible text="Изпрати запитване" /> <span class="btn-arrow" aria-hidden="true">→</span>
      </button>
      <p class="form-status text-center text-sm" role="status" aria-live="polite"></p>
      <p class="flex items-center justify-center gap-2 text-sm text-muted">
        <i class="fa-regular fa-clock" aria-hidden="true"></i> Отговаряме до 2 часа в работен ден.
      </p>
    </form>
  </div>
</section>

<footer class="relative z-[2] border-t border-white/10 bg-[#0a111c]">
  <div class="wrap flex flex-col gap-8 py-12 sm:flex-row sm:items-center sm:justify-between">
    <a href="#top" aria-label={`${site.name} — начало`}>
      <img src="/brand/stroydocs-logo-dark.svg" alt="StroyDocs — КСС, актове, оферти" width="236" height="72" class="h-[72px] w-auto" />
    </a>
    <p class="text-sm text-muted">Строителна документация · {site.city}</p>
    <a href={site.phoneHref} class="text-lg font-semibold">{site.phoneDisplay}</a>
  </div>
  <p class="wrap border-t border-white/10 py-6 text-xs text-white/35">© {new Date().getFullYear()} {site.name}. Всички права запазени.</p>
</footer>

<div class="fab">
  <a href={site.viberHref} class="fab-viber" aria-label="Пишете ни във Viber" data-viber><i class="fa-brands fa-viber" aria-hidden="true"></i></a>
  <a href={site.phoneHref} class="fab-call" aria-label={`Обадете се на ${site.phoneDisplay}`}><i class="fa-solid fa-phone" aria-hidden="true"></i></a>
</div>

<!-- Shown when a Viber link doesn't open the app (no Viber installed, desktop browser, blocked) -->
<div class="viber-help" role="dialog" aria-modal="false" aria-labelledby="viber-help-title" hidden data-viber-help>
  <button type="button" class="viber-help-close" aria-label="Затвори" data-viber-close>
    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
  </button>
  <p id="viber-help-title" class="viber-help-title"><i class="fa-brands fa-viber" aria-hidden="true"></i> Viber не се отвори?</p>
  <p class="viber-help-text">Намерете ни във Viber по номер или изберете друг начин:</p>
  <div class="viber-help-number">
    <b>{site.phoneDisplay}</b>
    <button type="button" class="viber-help-copy" data-viber-copy={site.phoneE164}>
      <i class="fa-regular fa-copy" aria-hidden="true"></i> <span>Копирай</span>
    </button>
  </div>
  <div class="viber-help-actions">
    <a href={site.viberHref} class="viber-help-btn viber">Опитай пак</a>
    <a href={site.phoneHref} class="viber-help-btn">Обади се</a>
    <a href={site.whatsappHref} class="viber-help-btn" target="_blank" rel="noopener">WhatsApp</a>
  </div>
</div>

